{
  "name": "@nx-nest-starter/admin-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "i18n:download": "tsx ./src/i18n/AdminDownloadI18n.ts",
    "swagger:generate": "cross-env NODE_ENV=local ts-node --project tsconfig.app.json -r tsconfig-paths/register src/support/api-docs/script/AdminSwaggerGenerator.ts",
    "lint": "nx run-many --target=lint --projects=admin-api,core-domain,core-enum,core-contract,core-util,core-database",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "nx run-many --target=test --projects=admin-api,core-domain --skip-nx-cache --passWithNoTests --parallel=1 --output-style=stream-without-prefixes",
    "test:e2e": "jest --config e2e-test/jest.config.cts --forceExit",
    "start:dev:local": "bash ../../scripts/dev-app.sh admin-api 9230",
    "build:local": "pnpm lint && nx build admin-api -c local",
    "start:local": "cross-env NODE_ENV=local node $(pwd)/../../dist/apps/admin-api/src/main.js",
    "build:development": "pnpm lint && nx build admin-api -c development",
    "start:development": "cross-env NODE_ENV=development node $(pwd)/../../dist/apps/admin-api/src/main.js",
    "build:production": "pnpm lint && nx build admin-api -c production",
    "start:production": "cross-env NODE_ENV=production node $(pwd)/../../dist/apps/admin-api/src/main.js"
  },
  "nx": {
    "name": "admin-api",
    "projectType": "application",
    "sourceRoot": "apps/admin-api/src",
    "includedScripts": [],
    "tags": [
      "app:admin-api",
      "scope:app"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/admin-api",
          "main": "apps/admin-api/src/main.ts",
          "tsConfig": "apps/admin-api/tsconfig.app.json",
          "swcrc": "apps/admin-api/.swcrc",
          "generatePackageJson": true,
          "skipTypeCheck": true
        },
        "configurations": {
          "local": {
            "args": [
              "node-env=local"
            ]
          },
          "development": {
            "args": [
              "node-env=development"
            ]
          },
          "production": {
            "args": [
              "node-env=production"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "admin-api:build",
          "runBuildTargetDependencies": false,
          "watch": true,
          "port": 9230
        },
        "configurations": {
          "local": {
            "buildTarget": "admin-api:build:local"
          },
          "development": {
            "buildTarget": "admin-api:build:development"
          },
          "production": {
            "buildTarget": "admin-api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-ses": "catalog:",
    "@nx-nest-starter/core-contract": "workspace:*",
    "@nx-nest-starter/core-database": "workspace:*",
    "@nx-nest-starter/core-domain": "workspace:*",
    "@nx-nest-starter/core-enum": "workspace:*",
    "@nx-nest-starter/core-util": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@sentry/nestjs": "catalog:",
    "@slack/client": "catalog:",
    "@swc/helpers": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "catalog:",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "firebase-admin": "catalog:",
    "joi": "catalog:",
    "morgan": "catalog:",
    "mysql2": "catalog:",
    "nestjs-i18n": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ts-jenum": "catalog:",
    "tslib": "catalog:",
    "typeorm": "catalog:",
    "typeorm-naming-strategies": "catalog:",
    "typeorm-transactional": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:"
  },
  "devDependencies": {
    "@lokalise/node-api": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/mysql": "catalog:",
    "@types/adm-zip": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/morgan": "catalog:",
    "@types/supertest": "catalog:",
    "adm-zip": "catalog:",
    "neverthrow": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:"
  }
}
