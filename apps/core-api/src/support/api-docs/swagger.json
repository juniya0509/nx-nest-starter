                    }
                  },
                  "example3": {
                    "summary": "만료된 토큰",
                    "value": {
                      "result": "ERROR",
                      "data": null,
                      "error": {
                        "code": "EXPIRED_JWT_ACCESS_TOKEN",
                        "message": "만료된 토큰",
                        "data": null
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "ERROR"
                      ]
                    },
                    "data": {
                      "type": "null",
                      "nullable": true
                    },
                    "error": {
                      "$ref": "#/components/schemas/ApiErrorMessage"
                    }
                  },
                  "required": [
                    "result",
                    "data",
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "Access JWT": []
          }
        ],
        "summary": "로그아웃",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/users/me": {
