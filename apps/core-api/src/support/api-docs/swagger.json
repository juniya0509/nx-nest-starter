  "info": {
    "title": "Nx Nest Starter Core API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "Access JWT": {
        "scheme": "bearer",
        "name": "Access JWT",
        "type": "http",
        "in": "header",
        "description": "Access JWT for user authentication",
        "x-apidog": {
          "authType": "bearer",
          "addTokenTo": "header",
          "headerPrefix": "Bearer",
          "token": "{{bearerToken}}"
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorMessage": {
        "type": "object",
        "properties": {
          "traceId": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "traceId",
          "code",
          "message"
        ]
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "ERROR"
            ]
          },
          "data": {
            "type": "object"
          },
          "error": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiErrorMessage"
              }
            ]
          }
        },
        "required": [
          "result",
          "data",
          "error"
        ]
      },
      "AuthTokenRes": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "description": "OAuth 2.0 token type — 항상 \"Bearer\". Authorization 헤더는 `Bearer <accessToken>` 형식으로 전송."
          },
          "accessToken": {
            "type": "string",
            "description": "JWT access token"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "description": "access token 만료까지 남은 초"
          },
          "refreshToken": {
            "type": "string",
            "description": "JWT refresh token"
          },
          "refreshTokenExpiresIn": {
            "type": "integer",
            "description": "refresh token 만료까지 남은 초"
          },
          "userId": {
            "type": "integer",
            "description": "로그인된 유저 ID"
          },
          "userEmail": {
            "type": "string",
            "description": "유저 이메일"
          },
          "userFullname": {
            "type": "string",
            "description": "유저 이름"
          },
          "userAvatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "유저 아바타 URL"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresIn",
          "userId",
          "userEmail",
          "userFullname",
          "userAvatarUrl"
        ]
      },
      "OauthCallbackDeviceReq": {
        "type": "object",
        "properties": {
          "deviceType": {
            "type": "string",
            "enum": [
              "WEB_BROWSER",
              "IOS_APP",
              "ANDROID_APP"
            ],
            "description": "디바이스 타입"
          },
          "pushToken": {
            "type": "string",
            "minLength": 1,
            "description": "FCM registration token (FE 의 firebase messaging SDK 가 발급)"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-US",
              "ko",
              "fr",
              "es",
              "de",
              "ja",
              "ms"
            ],
            "description": "이 디바이스의 언어 (push 알림 언어로 사용). user.defaultLanguage 와 별개."
          }
        },
        "required": [
          "deviceType",
          "pushToken",
          "language"
        ]
      },
      "OauthCallbackReq": {
        "type": "object",
        "properties": {
          "logtoAccessToken": {
            "type": "string",
            "minLength": 1,
            "description": "Logto SDK가 발급한 access token (FE의 SDK.getAccessToken() 결과)"
          },
          "provider": {
            "type": "string",
            "enum": [
              "KAKAO",
              "NAVER",
              "APPLE",
              "GOOGLE",
              "EMAIL"
            ],
            "description": "로그인 수단 (FE에서 사용자가 선택한 버튼)"
          },
          "device": {
            "description": "FCM 등록 정보. push 권한을 받아 token 을 보낼 수 있는 클라이언트만 채우면 됨. 미전송 시 device 등록 skip (push 알림 발송 대상에서 제외).",
            "allOf": [
              {
                "$ref": "#/components/schemas/OauthCallbackDeviceReq"
              }
            ]
          }
        },
        "required": [
          "logtoAccessToken",
          "provider"
        ]
      },
      "RefreshTokenReq": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "description": "발급받은 refresh token"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutReq": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "description": "로그아웃할 디바이스의 refresh token. 해당 row만 무효화되어 다른 기기 세션은 유지됨."
          },
          "pushToken": {
            "type": "string",
            "description": "이 디바이스의 FCM push token. 보내면 해당 device 등록을 함께 삭제 (push 비활성). 미전송 시 device 는 그대로 유지."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "GetMeRes": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "유저 ID"
          },
          "email": {
            "type": "string",
            "description": "이메일"
          },
          "firstname": {
            "type": "string",
            "nullable": true,
            "description": "이름"
          },
          "lastname": {
            "type": "string",
            "nullable": true,
            "description": "성"
          },
          "fullname": {
            "type": "string",
            "description": "firstname + lastname (둘 다 없으면 빈 문자열)"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "아바타 이미지 URL"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "WITHDRAWN",
              "DELETED"
            ],
            "description": "계정 상태"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "가입 일시"
          }
        },
        "required": [
          "id",
          "email",
          "firstname",
          "lastname",
          "fullname",
          "avatarUrl",
          "status",
          "createdAt"
        ]
      }
    }
  }
}