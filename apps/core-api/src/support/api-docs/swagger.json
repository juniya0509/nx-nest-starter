                        "data": null
                      }
                    }
                  },
                  "example2": {
                    "summary": "유효하지 않는 토큰",
                    "value": {
                      "result": "ERROR",
                      "data": null,
                      "error": {
                        "code": "INVALID_JWT_ACCESS_TOKEN",
