# ====================================================================
# .env.example
# ====================================================================
# 이 파일은 예시 환경 변수 파일입니다. 실제 값은 비어있습니다.
#
# 환경 종류:
#   - .env.local       : 로컬 개발 환경 (각 개발자 PC) — swagger:generate / i18n:download 도 이 파일을 공유
#   - .env.development : 개발(테스트) 서버 환경 — CI 의 i18n:download 도 이 파일을 공유
#   - .env.production  : 운영 서버 환경 — CI(master) 의 i18n:download 도 이 파일을 공유
#   - .env.test        : 테스트(자동화) 환경
#
# 사용법:
#   1. 각 애플리케이션 루트(예: apps/core-api/)에 .env.{환경} 파일 생성
#   2. 이 파일의 내용을 복사
#   3. 각 환경에 맞는 값으로 채우기
#
# 주의사항:
#   - .env.* 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록되어 있음)
#   - AWS, Sentry 등의 공용 자원 정보는 관리자에게 문의
# ====================================================================


# ===== Application =====
API_APP_NAME="core-api" # 변경 금지
SERVER_PORT=""

# ===== Client URL =====
CORE_WEB_URL=""
ADMIN_WEB_URL=""
CORS_ALLOWED_ORIGINS="" # 쉽표로 구분하여 여러 URL 입력 가능 (예: http://localhost:3000,http://example.com)

# ===== MySQL =====
MYSQL_DB_HOST=""
MYSQL_DB_PORT=""
MYSQL_DB_USERNAME=""
MYSQL_DB_PASSWORD=""
MYSQL_DB_NAME=""

# ===== JWT Auth =====
ACCESS_JWT_SECRET_KEY=""
ACCESS_JWT_EXPIRES_IN_SECOND=""
REFRESH_JWT_SECRET_KEY=""
REFRESH_JWT_EXPIRES_IN_SECOND=""

# ===== Logto OAuth2 =====
LOGTO_ENDPOINT=""        # 예: https://your-tenant.logto.app — BE가 /oidc/me 호출에 사용

# ===== AWS S3 =====
AWS_S3_URL=""
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION=""

# ===== AWS CloudFront =====
AWS_CLOUD_FRONT_RES_URL=""

# ===== AWS SES (Email) =====
SES_ACCESS_KEY=""
SES_SECRET_KEY=""
SES_REGION=""              # 예: ap-northeast-2
SES_FROM_EMAIL=""          # SES 에 verified 된 발신자 주소
SES_FROM_NAME=""           # 선택. 비우면 email-only 로 발송. 설정 시 "이름 <email>" 형식으로 발송
MAIL_COMPANY_NAME=""       # 메일 본문에 노출할 회사명
MAIL_PRODUCT_NAME=""       # 메일 본문에 노출할 제품명

# ===== Sentry (에러 추적) =====
SENTRY_CLIENT_DSN_KEY=""

# ===== Slack 알림 =====
SLACK_SERVER_ERROR_WEBHOOK_URL=""
SLACK_SERVER_SLOW_QUERY_WEBHOOK_URL=""

# ===== Twilio (SMS / WhatsApp) =====
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATS_APP_PHONE_NUMBER=""

# ===== Lokalise (번역) =====
LOKALISE_API_TOKEN=""
LOKALISE_PROJECT_ID=""

# ===== Firebase Admin =====
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY_BASE64="" # BASE64로 인코딩 된 private key

# ===== Logger =====
LOG_DIR="" # 선택. 비우면 process.cwd()/logs 사용 (운영에서는 /var/log/core-api 등 명시 권장)