# ====================================================================
# .env.example (batch)
# ====================================================================
# 환경 종류:
#   - .env.local       : 로컬 개발 환경 (각 개발자 PC)
#   - .env.development : 개발(테스트) 서버 환경 (EC2 dev) — CI 가 base64 secret 으로 디코드해 e2e 검증에도 사용
#   - .env.production  : 운영 서버 환경 (EC2 prod)
#
# 비고:
#   - batch 는 i18n / swagger 사용 안 함
#   - e2e 는 testcontainers 가 DB env 를 동적 주입하지만, 통일성을 위해 CI 에서도 .env 디코드는 수행
#
# 주의사항:
#   - .env.* 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록되어 있음)
# ====================================================================


# ===== Application =====
API_APP_NAME="batch"
SERVER_PORT=""             # 예: 3001 (ALB / ECS health check 용 HTTP 서버 포트)

# ===== MySQL =====
MYSQL_DB_HOST=""
MYSQL_DB_PORT=""
MYSQL_DB_USERNAME=""
MYSQL_DB_PASSWORD=""
MYSQL_DB_NAME=""

# ===== Sentry (에러 추적) =====
SENTRY_CLIENT_DSN_KEY=""

# ===== Slack 알림 =====
SLACK_SERVER_ERROR_WEBHOOK_URL=""

# ===== Logger =====
LOG_DIR="apps/batch/logs/"
